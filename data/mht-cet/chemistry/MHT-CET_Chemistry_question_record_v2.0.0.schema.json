{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MHT-CET Chemistry question record v2.0.0",
  "type": "object",
  "required": [
    "id",
    "subject",
    "standard",
    "chapter_number",
    "chapter_name",
    "stem",
    "options",
    "correct_option",
    "correct_answer_text",
    "solution",
    "difficulty",
    "source_locator",
    "generator_eligible_strict_cet"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CHEM-(11|12)-CH[0-9]{2}-[0-9]{4}$"
    },
    "subject": {
      "const": "Chemistry"
    },
    "standard": {
      "enum": [
        11,
        12
      ]
    },
    "chapter_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "chapter_name": {
      "type": "string",
      "minLength": 1
    },
    "stem": {
      "type": "string",
      "minLength": 10
    },
    "options": {
      "type": "object",
      "required": [
        "A",
        "B",
        "C",
        "D"
      ],
      "additionalProperties": false,
      "properties": {
        "A": {
          "type": "string",
          "minLength": 1
        },
        "B": {
          "type": "string",
          "minLength": 1
        },
        "C": {
          "type": "string",
          "minLength": 1
        },
        "D": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "correct_option": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "correct_answer_text": {
      "type": "string"
    },
    "solution": {
      "type": "string",
      "minLength": 10
    },
    "difficulty": {
      "enum": [
        "Easy",
        "Medium",
        "Hard",
        "Challenging"
      ]
    },
    "figure_asset": {
      "type": [
        "string",
        "null"
      ]
    },
    "calculator_required": {
      "type": "boolean"
    },
    "generator_eligible_strict_cet": {
      "type": "boolean"
    },
    "release_version": {
      "const": "2.0.0"
    }
  },
  "additionalProperties": true
}
