{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MHT-CET_Biology_question_record_v2.1.0.schema.json",
  "title": "MHT-CET Biology question record v2.1.0",
  "type": "object",
  "required": [
    "id",
    "standard",
    "chapter_number",
    "chapter_name",
    "major_topic",
    "subtopic",
    "concept_tested",
    "stem",
    "options",
    "correct_option",
    "correct_answer_text",
    "distractor_rationale",
    "solution",
    "formula_principle",
    "common_misconception",
    "difficulty",
    "difficulty_basis",
    "estimated_time",
    "question_type",
    "source_type",
    "source_basis",
    "figure_asset",
    "concept_family_id",
    "family_size",
    "syllabus_scope_status",
    "generator_eligible_strict_cet",
    "generator_eligible_extended_revision",
    "review_status",
    "review_status_note",
    "reviewer",
    "syllabus_version",
    "release_version",
    "source_locator",
    "source_alignment",
    "cognitive_process"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^BIO-(11|12)-CH[0-9]{2}-[0-9]{4}$"
    },
    "standard": {
      "enum": [
        11,
        12
      ]
    },
    "chapter_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15
    },
    "chapter_name": {
      "type": "string",
      "minLength": 1
    },
    "major_topic": {
      "type": "string",
      "minLength": 1
    },
    "subtopic": {
      "type": "string",
      "minLength": 1
    },
    "concept_tested": {
      "type": "string",
      "minLength": 1
    },
    "stem": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "object",
      "required": [
        "A",
        "B",
        "C",
        "D"
      ],
      "additionalProperties": false,
      "properties": {
        "A": {
          "type": "string",
          "minLength": 1
        },
        "B": {
          "type": "string",
          "minLength": 1
        },
        "C": {
          "type": "string",
          "minLength": 1
        },
        "D": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "correct_option": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "correct_answer_text": {
      "type": "string",
      "minLength": 1
    },
    "distractor_rationale": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 3,
      "additionalProperties": false,
      "properties": {
        "A": {
          "type": "string",
          "minLength": 1
        },
        "B": {
          "type": "string",
          "minLength": 1
        },
        "C": {
          "type": "string",
          "minLength": 1
        },
        "D": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "solution": {
      "type": "string",
      "minLength": 1
    },
    "formula_principle": {
      "type": "string",
      "minLength": 1
    },
    "common_misconception": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "enum": [
        "Easy",
        "Medium",
        "Hard",
        "Challenging"
      ]
    },
    "difficulty_basis": {
      "type": "string",
      "minLength": 1
    },
    "estimated_time": {
      "type": "string",
      "minLength": 1
    },
    "question_type": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "const": "ORIGINAL"
    },
    "source_basis": {
      "type": "string",
      "minLength": 1
    },
    "figure_asset": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^figures/.+\\.png$"
        }
      ]
    },
    "concept_family_id": {
      "type": "string",
      "minLength": 1
    },
    "family_size": {
      "type": "integer",
      "minimum": 1
    },
    "syllabus_scope_status": {
      "const": "IN_SCOPE"
    },
    "generator_eligible_strict_cet": {
      "type": "boolean"
    },
    "generator_eligible_extended_revision": {
      "type": "boolean"
    },
    "review_status": {
      "const": "MODEL_VERIFIED"
    },
    "review_status_note": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "syllabus_version": {
      "type": "string",
      "minLength": 1
    },
    "release_version": {
      "const": "2.1.0"
    },
    "source_locator": {
      "type": "string",
      "minLength": 1
    },
    "source_alignment": {
      "enum": [
        "LEGACY_REPAIRED_SUBSET",
        "TEXTBOOK_TERM_MATCH",
        "TEXTBOOK_CONCEPT_DIAGRAM"
      ]
    },
    "cognitive_process": {
      "type": "string",
      "minLength": 1
    }
  }
}